---
import LaceImage from "@lacecms/astro/LaceImage.astro";
import type { builtInBlocks } from "@lacecms/content";
import type { BlockProps } from "@lacecms/render";

type Props = BlockProps<typeof builtInBlocks.gallery>;

const { anchor, block, className, context, data, image, settings } = Astro.props;
const title = data.title?.trim() === "" ? undefined : data.title;
// Each item's own alt text and caption override the media item's.
const items = data.images.map((item) => {
  const media = image(item.media, item.alt);
  return { caption: item.caption ?? media.caption, media };
});
---

<section class:list={["gallery", className]} data-lace-block={block.type} data-lace-block-key={block.key} id={anchor}>
  {title !== undefined && <h2 data-lace-part="title">{title}</h2>}
  <ul data-lace-part="items" role="list">
    {items.map(({ caption, media }, index) => (
      <li data-lace-part="item">
        <figure>
          <LaceImage data-lace-part="media" image={media} lightbox={settings.lightbox} lightboxId={`lace-lightbox-${context.entryId}-${block.key}-${index}`} sizes="(min-width: 64rem) 20rem, (min-width: 32rem) 50vw, 100vw" />
          {caption !== undefined && <figcaption data-lace-part="caption">{caption}</figcaption>}
        </figure>
      </li>
    ))}
  </ul>
</section>
