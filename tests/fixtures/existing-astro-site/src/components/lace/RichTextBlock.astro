---
import RichText from "@lacecms/astro/RichText.astro";
import type { builtInBlocks } from "@lacecms/content";
import type { BlockProps } from "@lacecms/render";

type Props = BlockProps<typeof builtInBlocks.richText>;

const { block, context, data } = Astro.props;
---

<section class="rich-text" data-lace-block={block.type} data-lace-block-key={block.key}><div data-lace-part="content"><RichText context={{ block: context, fieldPath: ["content"] }} document={data.content} /></div></section>
