{
  "name": "@lacecms/server",
  "version": "0.1.0-alpha.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lacecms/lace.git",
    "directory": "packages/server"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src",
    "test": "vitest run src/*.test.mjs"
  },
  "dependencies": {
    "@hono/standard-validator": "catalog:",
    "@lacecms/application": "workspace:*",
    "@lacecms/contracts": "workspace:*",
    "@mjackson/multipart-parser": "catalog:",
    "@valibot/to-json-schema": "catalog:",
    "hono": "catalog:",
    "hono-openapi": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@lacecms/config": "workspace:*",
    "@lacecms/content": "workspace:*",
    "@lacecms/domain": "workspace:*",
    "@lacecms/test-utils": "workspace:*",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  }
}
