{
  "name": "@lacecms/mcp",
  "version": "0.1.0-rc1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lacecms/lace.git",
    "directory": "packages/mcp"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@lacecms/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "oxlint --deny-warnings src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:packaged": "vitest run --config vitest.packaged.config.mjs"
  },
  "dependencies": {
    "@lacecms/application": "workspace:*",
    "@lacecms/contracts": "workspace:*",
    "@lacecms/domain": "workspace:*",
    "@modelcontextprotocol/server": "catalog:",
    "@valibot/to-json-schema": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@lacecms/config": "workspace:*",
    "@lacecms/content": "workspace:*",
    "@lacecms/test-utils": "workspace:*",
    "@modelcontextprotocol/client": "catalog:",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
