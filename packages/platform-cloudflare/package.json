{
  "name": "@lacecms/platform-cloudflare",
  "version": "0.1.0-alpha.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lacecms/lace.git",
    "directory": "packages/platform-cloudflare"
  },
  "files": [
    "dist",
    "admin"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-admin-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src",
    "test": "vitest run src/*.test.mjs"
  },
  "dependencies": {
    "@lacecms/application": "workspace:*",
    "@lacecms/auth": "workspace:*",
    "@lacecms/config": "workspace:*",
    "@lacecms/content": "workspace:*",
    "@lacecms/db": "workspace:*",
    "@lacecms/domain": "workspace:*",
    "@lacecms/server": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "ulid": "catalog:"
  },
  "devDependencies": {
    "@lacecms/test-utils": "workspace:*",
    "miniflare": "catalog:",
    "oxlint": "catalog:",
    "sharp": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
