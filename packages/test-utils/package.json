{
  "name": "@lacecms/test-utils",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@lacecms/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./visibility-parity": {
      "@lacecms/source": "./src/visibility-parity.ts",
      "types": "./dist/visibility-parity.d.ts",
      "import": "./dist/visibility-parity.js"
    },
    "./filter-parity": {
      "@lacecms/source": "./src/filter-parity.ts",
      "types": "./dist/filter-parity.d.ts",
      "import": "./dist/filter-parity.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "oxlint --deny-warnings src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:packaged": "vitest run --config vitest.packaged.config.mjs"
  },
  "dependencies": {
    "@lacecms/application": "workspace:*",
    "@lacecms/config": "workspace:*",
    "@lacecms/content": "workspace:*",
    "@lacecms/contracts": "workspace:*",
    "@lacecms/domain": "workspace:*",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
