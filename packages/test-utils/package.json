{
  "name": "@lacecms/test-utils",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src",
    "test": "vitest run src/index.test.mjs"
  },
  "dependencies": {
    "@lacecms/application": "workspace:*",
    "@lacecms/config": "workspace:*",
    "@lacecms/content": "workspace:*",
    "@lacecms/contracts": "workspace:*",
    "@lacecms/domain": "workspace:*",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
