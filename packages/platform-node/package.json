{
  "name": "@lacecms/platform-node",
  "version": "0.1.0-rc1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lacecms/lace.git",
    "directory": "packages/platform-node"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@lacecms/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./test": {
      "@lacecms/source": "./src/test-actors.ts",
      "types": "./dist/test-actors.d.ts",
      "import": "./dist/test-actors.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "build": "node ../../scripts/platform-release-version.mjs && tsc -p tsconfig.json",
    "db:migrate": "pnpm run build && node dist/migrate.js",
    "typecheck": "node ../../scripts/platform-release-version.mjs --check && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "oxlint --deny-warnings src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:packaged": "vitest run --config vitest.packaged.config.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@lacecms/application": "workspace:*",
    "@lacecms/auth": "workspace:*",
    "@lacecms/config": "workspace:*",
    "@lacecms/content": "workspace:*",
    "@lacecms/db": "workspace:*",
    "@lacecms/domain": "workspace:*",
    "@lacecms/mcp": "workspace:*",
    "@lacecms/server": "workspace:*",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "better-sqlite3": "catalog:",
    "drizzle-orm": "catalog:",
    "nodemailer": "catalog:",
    "sharp": "catalog:",
    "ulid": "catalog:"
  },
  "devDependencies": {
    "@lacecms/test-utils": "workspace:*",
    "better-auth": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
