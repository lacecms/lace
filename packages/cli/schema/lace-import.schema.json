{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lace import package v1",
  "description": "lace-import.json of a lace import package. Field, block and SEO values are validated against the project's lace.config.ts by `lace import`.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "formatVersion": {
      "const": 1
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "alt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "caption": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "focalPoint": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": ["x", "y"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 100
          }
        },
        "required": ["key", "file"],
        "additionalProperties": false
      },
      "maxItems": 5000
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {}
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "data": {
                  "type": "object",
                  "additionalProperties": {}
                },
                "settings": {
                  "type": "object",
                  "additionalProperties": {}
                },
                "anchor": {
                  "type": "string"
                },
                "className": {
                  "type": "string"
                },
                "hidden": {
                  "type": "boolean"
                }
              },
              "required": ["type", "data"],
              "additionalProperties": false
            },
            "maxItems": 1000
          },
          "seo": {
            "type": "object",
            "additionalProperties": {}
          },
          "publish": {
            "type": "boolean"
          }
        },
        "required": ["key", "model", "fields", "blocks"],
        "additionalProperties": false
      },
      "maxItems": 5000
    }
  },
  "required": ["formatVersion", "media", "entries"],
  "additionalProperties": false
}
