{
  "name": "@lacecms/cli",
  "version": "0.1.0-alpha.8",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lacecms/lace.git",
    "directory": "packages/cli"
  },
  "bin": {
    "lace": "./dist/bin.js"
  },
  "files": [
    "dist",
    "schema"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lace-import.schema.json": "./schema/lace-import.schema.json"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle-registry.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src",
    "test": "vitest run src/*.test.mjs",
    "schema": "node scripts/generate-import-schema.mjs"
  },
  "dependencies": {
    "@lacecms/application": "workspace:*",
    "@lacecms/config": "workspace:*",
    "@lacecms/contracts": "workspace:*",
    "@lacecms/platform-cloudflare": "workspace:*",
    "@lacecms/platform-node": "workspace:*",
    "miniflare": "catalog:",
    "semver": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@lacecms/content": "workspace:*",
    "@lacecms/test-utils": "workspace:*",
    "@types/node": "catalog:",
    "@valibot/to-json-schema": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
