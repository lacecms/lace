---
import LaceBlocks from "@lacecms/astro/LaceBlocks.astro";
import LaceSeo from "@lacecms/astro/LaceSeo.astro";
import type { PublishedEntry, PublishedSite } from "@lacecms/sdk";
import { blocks } from "../lace/blocks";
import "../styles/global.css";

interface Props {
  readonly entry: PublishedEntry;
  readonly site: PublishedSite;
  /** The Open Graph type; blog posts render as articles. */
  readonly type?: "article" | "website";
}

const { entry, site, type } = Astro.props;

// Site-wide text comes from the published `settings` global; the static values
// keep the header complete until it is published in Admin.
const settings = site.global("settings")?.fields ?? {};
const text = (value: unknown): string | undefined =>
  typeof value === "string" && value.trim() !== "" ? value : undefined;
const siteName = text(settings.siteName) ?? "Lace starter";
const tagline = text(settings.tagline);
const help = site.link(settings.helpUrl);
// Site-wide links come from the published `navigation` global; the static link
// stands in until it is published in Admin.
const navigation = site.global("navigation");
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <!-- Title, description, canonical URL and social tags with CMS fallbacks. -->
    <LaceSeo seo={site.seo(entry)} type={type} />
  </head>
  <body>
    <header class="site-header">
      <a class="site-name" href={base}>{siteName}</a>
      {tagline === undefined ? null : <p class="site-tagline">{tagline}</p>}
      {help.state === "resolved" ? <a href={help.href}>Help</a> : help.state === "unavailable" ? <span>Help</span> : null}
      {navigation === undefined ? (
        <nav aria-label="Main" class="site-nav">
          <ul>
            <li><a href={base}>Home</a></li>
          </ul>
        </nav>
      ) : (
        <LaceBlocks blocks={blocks} entry={navigation} mediaUrl={site.mediaUrl} />
      )}
    </header>
    <main data-lace-model={entry.modelKey} data-lace-entry={entry.id}><slot /></main>
  </body>
</html>
