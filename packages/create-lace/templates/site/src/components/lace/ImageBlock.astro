---
import type { builtInBlocks } from "@lacecms/content";
import type { BlockProps } from "@lacecms/render";

type Props = BlockProps<typeof builtInBlocks.image>;

const { block, data, image } = Astro.props;
const media = image(data.media, data.alt);
const caption = data.caption ?? media.caption;
---

<figure data-lace-block={block.type} data-lace-block-key={block.key}>
  <img alt={media.alt} data-lace-part="media" height={media.height} src={media.src} style={media.objectPosition === undefined ? undefined : { "object-position": media.objectPosition }} width={media.width} />
  {caption !== undefined && <figcaption data-lace-part="caption">{caption}</figcaption>}
</figure>
