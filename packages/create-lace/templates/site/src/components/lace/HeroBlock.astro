---
import RichText from "@lacecms/astro/RichText.astro";
import type { builtInBlocks } from "@lacecms/content";
import type { BlockProps } from "@lacecms/render";

type Props = BlockProps<typeof builtInBlocks.hero>;

const { anchor, block, className, context, data, image } = Astro.props;
const media = data.image === undefined ? undefined : image(data.image);
---

<section class:list={["hero", className]} data-lace-block={block.type} data-lace-block-key={block.key} id={anchor}>
  {data.eyebrow !== undefined && <p data-lace-part="eyebrow">{data.eyebrow}</p>}
  <h1 data-lace-part="heading">{data.heading}</h1>
  {data.body !== undefined && <div data-lace-part="body"><RichText context={{ block: context, fieldPath: ["body"] }} document={data.body} /></div>}
  {media !== undefined && <img alt={media.alt} data-lace-part="media" height={media.height} src={media.src} style={media.objectPosition === undefined ? undefined : { "object-position": media.objectPosition }} width={media.width} />}
  {data.primaryActionLabel !== undefined && data.primaryActionUrl !== undefined && <a data-lace-part="action" href={data.primaryActionUrl}>{data.primaryActionLabel}</a>}
</section>
