---
import "./ListLayout.css";
import LaceImage from "@lacecms/astro/LaceImage.astro";
import type { builtInBlocks } from "@lacecms/content";
import type { BlockProps } from "@lacecms/render";

type Props = BlockProps<typeof builtInBlocks.gallery>;

const { anchor, block, className, context, data, image, settings, link } = Astro.props;
const title = data.title?.trim() === "" ? undefined : data.title;
// Each item's own alt text and caption override the media item's. A linked item
// opens its link instead of the lightbox; the alt text names the link, then the
// caption, then the URL.
const items = data.images.map((item) => {
  const destination = link(item.link);
  const href = destination.state === "resolved" ? destination.href : undefined;
  const media = image(item.media, item.alt);
  const caption = item.caption ?? media.caption;
  const linkLabel = media.alt === "" ? (caption?.trim() || href) : undefined;
  return { caption, link: href, linkLabel, media };
});
const sizes = settings.layoutMode === "grid" && settings.layoutPreset === "auto"
  ? "(min-width: 64rem) 20rem, (min-width: 32rem) 50vw, 100vw"
  : "100vw";
---

<section class:list={["gallery", className]} data-lace-block={block.type} data-lace-block-key={block.key} data-lace-layout-container id={anchor}>
  {title !== undefined && <h2 data-lace-part="title">{title}</h2>}
  <ul data-lace-part="items" data-lace-layout={settings.layoutMode} data-lace-wrap={String(settings.layoutWrap)} data-lace-preset={settings.layoutPreset} role="list">
    {items.map(({ caption, link, linkLabel, media }, index) => (
      <li data-lace-part="item" data-lace-layout-item>
        <figure>
          {link === undefined ? (
            <LaceImage data-lace-part="media" image={media} lightbox={settings.lightbox} lightboxId={`lace-lightbox-${context.entryId}-${block.key}-${index}`} sizes={sizes} />
          ) : (
            <a aria-label={linkLabel} data-lace-part="link" href={link}>
              <LaceImage data-lace-part="media" image={media} sizes={sizes} />
            </a>
          )}
          {caption !== undefined && <figcaption data-lace-part="caption">{caption}</figcaption>}
        </figure>
      </li>
    ))}
  </ul>
</section>
