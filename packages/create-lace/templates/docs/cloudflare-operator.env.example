# Private runtime copy: .lace/cloudflare-operator.env (owner-only permissions).
# Load explicitly with lace ... --target cloudflare-remote --operator-env <path>.
# Do not place the operator API token in .env or .env.local: Wrangler loads them.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
LACE_D1_DATABASE_ID=
LACE_WRANGLER_CONFIG=worker/wrangler.jsonc
