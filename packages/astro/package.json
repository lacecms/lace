{
  "name": "@lacecms/astro",
  "version": "0.1.0-rc1",
  "keywords": [
    "astro-component",
    "lace"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lacecms/lace.git",
    "directory": "packages/astro"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@lacecms/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./LaceBlocks.astro": {
      "@lacecms/source": "./src/LaceBlocks.astro",
      "default": "./dist/LaceBlocks.astro"
    },
    "./LaceImage.astro": {
      "@lacecms/source": "./src/LaceImage.astro",
      "default": "./dist/LaceImage.astro"
    },
    "./LaceSeo.astro": {
      "@lacecms/source": "./src/LaceSeo.astro",
      "default": "./dist/LaceSeo.astro"
    },
    "./RichText.astro": {
      "@lacecms/source": "./src/RichText.astro",
      "default": "./dist/RichText.astro"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node copy-components.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "oxlint --deny-warnings src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:packaged": "vitest run --config vitest.packaged.config.mjs"
  },
  "dependencies": {
    "@lacecms/render": "workspace:*",
    "@lacecms/sdk": "workspace:*"
  },
  "devDependencies": {
    "@lacecms/content": "workspace:*",
    "@types/node": "catalog:",
    "astro": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "astro": "^7.3.1"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
