---
import type { RichTextDescriptionNode } from "@lacecms/render";
import type { RichTextComponents } from "./index.js";

interface Props {
  readonly components: RichTextComponents;
  readonly nodes: readonly RichTextDescriptionNode[];
}

const { components, nodes } = Astro.props;
---

{
  nodes.map((node) => {
    if (node.kind === "text") return node.text;
    const Override = components[node.source];
    if (Override !== undefined)
      return <Override element={node}><Astro.self components={components} nodes={node.children} /></Override>;
    if (node.tag === "br") return <br />;
    if (node.tag === "hr") return <hr />;
    const Tag = node.tag;
    return node.tag === "a" ? (
      <a href={node.attributes.href} target={node.attributes.target} rel={node.attributes.rel}><Astro.self components={components} nodes={node.children} /></a>
    ) : (
      <Tag><Astro.self components={components} nodes={node.children} /></Tag>
    );
  })
}
