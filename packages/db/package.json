{
  "name": "@lacecms/db",
  "version": "0.1.0-alpha.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lacecms/lace.git",
    "directory": "packages/db"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate --config ../../drizzle.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src",
    "test": "vitest run src/index.test.mjs"
  },
  "dependencies": {
    "@lacecms/application": "workspace:*",
    "@lacecms/content": "workspace:*",
    "@lacecms/domain": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
