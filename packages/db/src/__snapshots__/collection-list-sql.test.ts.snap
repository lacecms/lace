// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`list statements and bindings preserve every sort family 1`] = `
[
  {
    "items": {
      "params": [
        "posts",
        "%hello%",
        "$.target",
        "%a\\_\\%%",
        "["target"]",
        11,
      ],
      "sql": "select e.id, e.model_key, e.published_snapshot_id, e.updated_at, d.id as draft_snapshot_id,
    d.revision as draft_revision, d.title, d.slug, (select json_group_object(value, json(d.fields_json -> ('$.' || value))) from json_each(?5)) as fields_json, d.updated_by,
    u.name as updated_by_name, p.created_at as published_at, case when e.published_snapshot_id is null then 'draft'
  when p.revision = d.revision then 'published' else 'changed' end as status, null as sort_value, (case when coalesce(json_type(d.fields_json, ?3)='text' and json_extract(d.fields_json, ?3)<>'',0) then 0 else 1 end) as sort_missing
    from content_entries e
  join content_snapshots d on d.id = e.draft_snapshot_id
  left join content_snapshots p on p.id = e.published_snapshot_id left join user u on u.id=d.updated_by where e.model_key = ?1 and (d.title like ?2 escape '\\' or coalesce(d.slug,'') like ?2 escape '\\') and (coalesce(json_type(d.fields_json, ?3)='text' and json_extract(d.fields_json, ?3)<>'',0) and json_extract(d.fields_json, ?3) like ?4 escape '\\')
    order by (case when coalesce(json_type(d.fields_json, ?3)='text' and json_extract(d.fields_json, ?3)<>'',0) then 0 else 1 end) asc, (case when coalesce(json_type(d.fields_json, ?3)='text' and json_extract(d.fields_json, ?3)<>'',0) then json_extract(d.fields_json, ?3) else null end) collate nocase asc, e.id asc limit ?6",
    },
    "totals": {
      "params": [
        "posts",
        "%hello%",
        "$.target",
        "%a\\_\\%%",
      ],
      "sql": "select count(*) as total_count, sum(case when e.published_snapshot_id is null then 1 else 0 end) as draft_count,
    sum(case when p.revision=d.revision then 1 else 0 end) as published_count, sum(case when p.revision<>d.revision then 1 else 0 end) as changed_count
    from content_entries e
  join content_snapshots d on d.id = e.draft_snapshot_id
  left join content_snapshots p on p.id = e.published_snapshot_id where e.model_key = ?1 and (d.title like ?2 escape '\\' or coalesce(d.slug,'') like ?2 escape '\\') and (coalesce(json_type(d.fields_json, ?3)='text' and json_extract(d.fields_json, ?3)<>'',0) and json_extract(d.fields_json, ?3) like ?4 escape '\\')",
