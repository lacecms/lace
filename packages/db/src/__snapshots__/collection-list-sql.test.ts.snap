    from content_entries e
  join content_snapshots d on d.id = e.draft_snapshot_id
  left join content_snapshots p on p.id = e.published_snapshot_id left join user u on u.id=d.updated_by where e.model_key = ?1 and (d.title like ?2 escape '\\' or coalesce(d.slug,'') like ?2 escape '\\') and (coalesce(json_type(d.fields_json, ?3) in ('integer','real') and abs(json_extract(d.fields_json, ?3)) <= 1.7976931348623157e308,0) and json_extract(d.fields_json, ?3) >= ?4 and json_extract(d.fields_json, ?3) <= ?5)
    order by (case when coalesce(json_type(d.fields_json, ?3) in ('integer','real') and abs(json_extract(d.fields_json, ?3)) <= 1.7976931348623157e308,0) then 0 else 1 end) asc, (case when coalesce(json_type(d.fields_json, ?3) in ('integer','real') and abs(json_extract(d.fields_json, ?3)) <= 1.7976931348623157e308,0) then json_extract(d.fields_json, ?3) else null end) asc, e.id asc limit ?7",
