# Local Node development only. Copy this to ignored .env, then run `pnpm dev:env`
# to generate unique credentials. None of the placeholder values are usable secrets.
LACE_API_PORT=3000
LACE_PUBLIC_BASE_URL=http://127.0.0.1:3000/
LACE_HOST=0.0.0.0
LACE_PORT=3000
LACE_DATABASE_DIRECTORY=/workspace/dev-data
LACE_DATABASE_PATH=/workspace/dev-data/lace.sqlite
LACE_DATA_VOLUME_PREFIX=lace-dev
LACE_ADMIN_DEV_ORIGIN=http://admin:5173
LACE_SITE_DEV_ORIGIN=http://site:4321
# Keep fixture mode for first-admin setup. After creating a build token, set
# LACE_SITE_DATA_MODE=live and paste the once-shown token in the ignored .env.
LACE_SITE_DATA_MODE=fixture
LACE_BUILD_TOKEN=
LACE_MINIO_ENDPOINT=http://minio:9000
LACE_MINIO_BUCKET=lace-media
LACE_MINIO_REGION=us-east-1
LACE_MINIO_TIMEOUT_MS=5000
# `pnpm dev:env` creates one local-only pair and uses it for both root and API access.
LACE_MINIO_ROOT_ACCESS_KEY=
LACE_MINIO_ROOT_SECRET=
LACE_MINIO_ACCESS_KEY=
LACE_MINIO_SECRET_KEY=
LACE_AUTH_SECRET=
# Outgoing email goes to the local Mailpit inbox at http://127.0.0.1:8025/.
# Development-only plaintext SMTP; never use real provider credentials here.
LACE_MAILPIT_PORT=8025
LACE_EMAIL_PROVIDER=smtp
LACE_EMAIL_FROM=Lace Dev <lace@localhost.test>
LACE_SMTP_HOST=mailpit
LACE_SMTP_PORT=1025
LACE_SMTP_SECURITY=none
