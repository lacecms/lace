{
  "name": "@lacecms/app-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "dev:container": "ASTRO_DEV_BACKGROUND=1 ASTRO_TELEMETRY_DISABLED=1 astro dev --force --host 0.0.0.0 --port 4321 --strictPort",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro sync && tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@lacecms/astro": "workspace:*",
    "@lacecms/content": "workspace:*",
    "@lacecms/render": "workspace:*",
    "@lacecms/sdk": "workspace:*",
    "astro": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
