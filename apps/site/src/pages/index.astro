---
import LaceBlocks from "@lacecms/astro/LaceBlocks.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { blocks } from "../lace/blocks.js";
import { getSite } from "../lib/lace.js";

const site = await getSite();
const home = site.byPath("/");
if (home === undefined)
  throw new Error(
    "The build export contains no published entry at /. Run `pnpm content:sync`, then publish the home page in Admin.",
  );
---

<BaseLayout entry={home} site={site}>
  <LaceBlocks blocks={blocks} entry={home} mediaUrl={site.mediaUrl} />
</BaseLayout>
