---
import LaceBlocks from "@lacecms/astro/LaceBlocks.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { blocks } from "../../lace/blocks";
import { getSite } from "../../lib/lace";

export async function getStaticPaths() {
  const site = await getSite();
  return site.entries("posts").map((entry) => ({ params: { slug: entry.slug } }));
}

// Read the current entry on each render so Astro dev shows publications on reload.
const site = await getSite();
const entry = site.bySlug("posts", Astro.params.slug ?? "");
if (entry === undefined) return new Response(null, { status: 404 });
---

<BaseLayout entry={entry} title={entry.title}>
  <LaceBlocks blocks={blocks} entry={entry} mediaUrl={site.mediaUrl} />
</BaseLayout>
