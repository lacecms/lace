---
import LaceBlocks from "@lacecms/astro/LaceBlocks.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { blocks } from "../../lace/blocks.js";
import { getSite } from "../../lib/lace.js";

const site = await getSite();
const about = site.byPath("/about");
if (about === undefined) return new Response(null, { status: 404 });
---

<BaseLayout entry={about} site={site}>
  <LaceBlocks blocks={blocks} entry={about} mediaUrl={site.mediaUrl} />
</BaseLayout>
