---
import LaceBlocks from "@lacecms/astro/LaceBlocks.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { blocks } from "../../lace/blocks";
import { getSite } from "../../lib/lace";

export async function getStaticPaths() {
  const site = await getSite();
  return site.byPath("/about") === undefined ? [] : [{ params: { slug: undefined } }];
}

const site = await getSite();
const about = site.byPath("/about");
if (about === undefined) return new Response(null, { status: 404 });
---

<BaseLayout entry={about} title={about.title}>
  <LaceBlocks blocks={blocks} entry={about} mediaUrl={site.mediaUrl} />
</BaseLayout>
