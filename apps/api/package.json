{
  "name": "@lacecms/app-api",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm run build && node dist/dev.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p worker/tsconfig.json && tsc -p tsconfig.test.json",
    "lint": "oxlint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:packaged": "vitest run --config vitest.packaged.config.mjs"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@lacecms/platform-cloudflare": "workspace:*",
    "@lacecms/platform-node": "workspace:*",
    "@lacecms/server": "workspace:*"
  },
  "devDependencies": {
    "@lacecms/application": "workspace:*",
    "@lacecms/config": "workspace:*",
    "@lacecms/domain": "workspace:*",
    "@lacecms/test-utils": "workspace:*",
    "@types/node": "catalog:",
    "miniflare": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
