---
import LaceVideo from "@lacecms/astro/LaceVideo.astro";
import type { builtInBlocks } from "@lacecms/content";
import { describeVideoEmbed, type BlockProps } from "@lacecms/render";
import "./VideoEmbed.css";

type Props = BlockProps<typeof builtInBlocks.videoEmbed>;
const { anchor, block, className, context, data, image, settings } = Astro.props;
const video = describeVideoEmbed(data.url, context);
const poster = data.poster === undefined ? undefined : image(data.poster);
---

<LaceVideo
  class:list={["video-embed", className]}
  id={anchor}
  data-lace-block={block.type}
  data-lace-block-key={block.key}
  video={video}
  url={data.url}
  title={data.title}
  aspectRatio={settings.aspectRatio}
  playback={settings.playback}
  poster={poster}
  posterSizes="(min-width: 64rem) 60rem, 100vw"
  caption={data.caption}
/>
