{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@lacecms/cli#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/registry/**"],
      "outputs": ["dist/**"]
    },
    "@lacecms/platform-cloudflare#build": {
      "dependsOn": ["^build", "@lacecms/app-admin#build"],
      "outputs": ["dist/**", "admin/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "outputs": []
    },
    "@lacecms/app-admin#typecheck": {
      "dependsOn": [
        "^build",
        "^typecheck",
        "@lacecms/application#build",
        "@lacecms/config#build",
        "@lacecms/domain#build",
        "@lacecms/platform-node#build"
      ],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "test": {
      "dependsOn": [],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/registry/**",
        "$TURBO_ROOT$/lace.config.ts",
        "$TURBO_ROOT$/apps/site/src/fixtures/**"
      ]
    },
    "@lacecms/app-docs#build": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/api/openapi/api-v1.json"],
      "outputs": ["dist/**"]
    },
    "test:packaged": {
      "dependsOn": ["build", "^build"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tests/fixtures/**",
        "$TURBO_ROOT$/tests/support/**",
        "$TURBO_ROOT$/lace.config.ts"
      ]
    },
    "@lacecms/platform-node#test:packaged": {
      "dependsOn": ["build", "^build", "@lacecms/astro#build"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tests/fixtures/**",
        "$TURBO_ROOT$/tests/support/**",
        "$TURBO_ROOT$/lace.config.ts"
      ]
    },
    "@lacecms/platform-cloudflare#test:packaged": {
      "dependsOn": ["build", "^build", "@lacecms/astro#build"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tests/fixtures/**",
        "$TURBO_ROOT$/tests/support/**",
        "$TURBO_ROOT$/lace.config.ts"
      ]
    }
  },
  "globalDependencies": ["vitest.shared.mjs"]
}
