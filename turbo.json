{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@lacecms/cli#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/registry/**"],
      "outputs": ["dist/**"]
    },
    "@lacecms/platform-cloudflare#build": {
      "dependsOn": ["^build", "@lacecms/app-admin#build"],
      "outputs": ["dist/**", "admin/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "outputs": []
    },
    "@lacecms/app-admin#typecheck": {
      "dependsOn": [
        "^build",
        "^typecheck",
        "@lacecms/application#build",
        "@lacecms/config#build",
        "@lacecms/domain#build",
        "@lacecms/platform-node#build"
      ],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "outputs": []
    }
  }
}
